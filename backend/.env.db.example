# ==============================================================
# Database PII Discovery — local demo configuration
# ==============================================================

# Existing backend values needed for a simple local demo.
USE_MOCK_DB=1
PORT=8001
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# SQLite target databases must live under backend/demo_data by default.
DB_SQLITE_ROOT=demo_data
DB_SCAN_SAMPLE_LIMIT=50
DB_SCAN_MAX_TABLES=100

# PostgreSQL demo only.
# INSERT A LONG LOCAL-DEMO PASSWORD HERE.
# This value must match demo_postgres.sql if you use that demo script.
DPDP_DB_POSTGRES_DEMO_PASSWORD=INSERT_MATCH_THE_VALUE_IN_DEMO_POSTGRES_SQL